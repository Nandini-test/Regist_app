# Copy this file to .env and change the values
PORT=3000
NODE_ENV=development
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ---- Email for "Forgot password" (optional) ----
# Leave these empty to print reset links in the terminal instead.
# Gmail example: turn on 2-Step Verification, create an App Password
# (Google Account > Security > App passwords) and paste it as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
